{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "telegram-monitor-frontend",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "BACKEND_ORIGIN": "http://localhost:8080"
  },
  "env": {
    "production": {
      "routes": [
        {
          "pattern": "promos.matrochares.qzz.io/*",
          "zone_name": "matrochares.qzz.io",
          "custom_domain": true
        }
      ],
      "vars": {
        "BACKEND_ORIGIN": "https://api.promos.matrochares.qzz.io"
      }
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "workers_dev": false,
  "preview_urls": false
}
